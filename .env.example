# ==========================================
# Whale Tracker Configuration
# ==========================================

# ==========================================
# LLM / AI Configuration
# ==========================================

# Primary LLM provider: lmstudio, ollama, claude, openai
LLM_PROVIDER=ollama

# Enable AI reasoning (set to false for rule-based only)
ENABLE_REASONING=true

# Reasoning parameters
MAX_REASONING_ITERATIONS=5
REASONING_TIMEOUT=30

# ------------------------------------------
# LMStudio (Local - requires LMStudio running on host)
# ------------------------------------------
LMSTUDIO_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=local-model

# ------------------------------------------
# Ollama (Local - Docker container)
# ------------------------------------------
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Available models:
#   llama3.1:8b      - Recommended, good balance (8GB VRAM)
#   mistral:7b       - Fast, efficient (6GB VRAM)
#   qwen2.5:14b      - High quality (14GB VRAM)
#   deepseek-coder:6.7b - Code specialist (6GB VRAM)

# ------------------------------------------
# Claude (Cloud - requires API key)
# ------------------------------------------
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Get API key: https://console.anthropic.com/

# ------------------------------------------
# OpenAI (Cloud - requires API key)
# ------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Get API key: https://platform.openai.com/

# ==========================================
# Blockchain API Keys (REQUIRED)
# ==========================================

# Etherscan API Key (V2 - works across all supported chains)
# Sign up: https://etherscan.io/apis
# With Etherscan API V2, a single API key works for all chains including:
# - Ethereum (chainid=1)
# - Arbitrum (chainid=42161)
# - And 60+ other supported networks
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# DEPRECATED: ARBISCAN_API_KEY is no longer needed with Etherscan API V2
# The single ETHERSCAN_API_KEY above now works for all chains
# ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Infura API Key (for RPC endpoints)
# Sign up: https://infura.io/
INFURA_API_KEY=your_infura_project_id_here

# ==========================================
# Telegram Bot Configuration (REQUIRED)
# ==========================================

# Telegram Bot Token
# Create bot: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (your user ID or group ID)
# Get your ID: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# ==========================================
# Application Settings
# ==========================================

# Polling interval in seconds (how often to check for new transactions)
POLLING_INTERVAL=60

# Transaction threshold in ETH (minimum value to trigger alerts)
TRANSACTION_THRESHOLD=50

# Test mode chat ID (optional, for testing)
TEST_CHAT_ID=

# ==========================================
# TRADING BOT CONFIGURATION
# ==========================================

# Trading Symbols (comma-separated, use Binance format)
TRADING_SYMBOLS=BTCUSDT,ETHUSDT

# Trading Timeframe (1m, 5m, 15m, 1h, 4h, 1d)
TRADING_TIMEFRAME=15m

# Check interval in seconds (how often to analyze signals)
CHECK_INTERVAL_SECONDS=60

# Enabled Trading Strategies (comma-separated)
# Available: EMA_CROSSOVER, RSI_DIVERGENCE, SCALPING_TRIPLE, DIVERGENCE_DETECTOR, OPEN_INTEREST
ENABLED_STRATEGIES=EMA_CROSSOVER,RSI_DIVERGENCE,SCALPING_TRIPLE,DIVERGENCE_DETECTOR

# ==========================================
# RISK MANAGEMENT
# ==========================================

# Initial capital in USD
INITIAL_CAPITAL=10000

# Risk per trade as percentage of capital (1.0 = 1%)
RISK_PER_TRADE_PCT=1.0

# Maximum number of open positions simultaneously
MAX_OPEN_POSITIONS=3

# Maximum total portfolio risk as percentage (20.0 = 20%)
MAX_RISK_PCT=20.0

# ==========================================
# DATA SOURCES
# ==========================================

# Price data source: BINANCE, COINGECKO, COINBASE
PRICE_SOURCE=BINANCE

# ==========================================
# TRADING BOT AI REASONING (Optional)
# ==========================================

# Enable AI reasoning for signal aggregation
# Uses the LLM configured above (ENABLE_REASONING must also be true)
ENABLE_AI_REASONING=false
